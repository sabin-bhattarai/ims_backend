# Copy to .env for local development. Never commit a real .env.
# Deployed environments inject these via GitHub Environments -> secrets.

# --- runtime ---------------------------------------------------------------
ENV=development                  # development | staging | production
PORT=8080
LOG_LEVEL=info                   # trace | debug | info | warn | error
SHUTDOWN_TIMEOUT=15s

# --- database --------------------------------------------------------------
DATABASE_URL=postgres://ims:ims@localhost:5432/ims?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
# Applies pending migrations on boot. MUST be false in production, where
# migrations run as a deploy step — N replicas racing to migrate corrupts a
# schema. The app refuses to start if this is true while ENV=production.
AUTO_MIGRATE=true

# --- cache and queue -------------------------------------------------------
# The API degrades gracefully without Redis: cache reads miss, the rate limiter
# fails open and background jobs are dropped with a warning.
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=ims
QUEUE_CONCURRENCY=10

# --- auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Must be at least 32 characters when ENV=production.
JWT_SECRET=change-me-to-a-32-character-minimum-secret
JWT_ISSUER=ims-backend
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=1h
BCRYPT_COST=12

# --- limits and CORS -------------------------------------------------------
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m
# Comma-separated. Must list the exact web origin: credentials are sent with
# requests, so a wildcard will be rejected by the browser.
CORS_ORIGINS=http://localhost:5173

# --- notifications ---------------------------------------------------------
# Local dev points at Mailpit (docker-compose): http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ims.local

# Firebase Cloud Messaging server key for mobile push. Empty disables push.
FCM_SERVER_KEY=

# Used to build password-reset links in emails.
WEB_APP_BASE_URL=http://localhost:5173
